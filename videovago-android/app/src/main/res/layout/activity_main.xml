<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp">

        <Button
            android:id="@+id/btnOpen"
            style="@style/Btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📂 Megnyitás" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:singleLine="true"
                android:text="Nincs megnyitott videó"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/muted"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- video -->
    <FrameLayout
        android:id="@+id/videoBox"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000000"
        android:clipChildren="true">

        <TextureView
            android:id="@+id/texture"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />

        <TextView
            android:id="@+id/placeholder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="24dp"
            android:text="🎬\n\nNyiss meg egy videót a Megnyitás gombbal,\nvagy oszd meg ide a Galériából.\n\nA vágás és a forgatás veszteségmentes:\naz app nem kódolja újra a képet."
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/rotBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:background="#B3000000"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:textColor="@color/text"
            android:textSize="12sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- transport -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/panel"
        android:orientation="vertical"
        android:paddingTop="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/txtTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="00:00.000"
                android:textColor="@color/text"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/txtTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="monospace"
                android:textColor="@color/muted"
                android:textSize="12sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/txtSel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:gravity="end"
                android:textColor="#FFC440"
                android:textSize="11sp" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <Button android:id="@+id/btnPlay" style="@style/Btn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="▶" />
                <Button android:id="@+id/btnPrevKey" style="@style/Btn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⏮K" />
                <Button android:id="@+id/btnPrevFrame" style="@style/Btn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="◀|" />
                <Button android:id="@+id/btnNextFrame" style="@style/Btn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="|▶" />
                <Button android:id="@+id/btnNextKey" style="@style/Btn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="K⏭" />
                <Button android:id="@+id/btnIn" style="@style/Btn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="[ Kezdet" />
                <Button android:id="@+id/btnOut" style="@style/Btn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Vég ]" />
                <Button android:id="@+id/btnAdd" style="@style/Btn.Primary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+ Szakasz" />
                <Button android:id="@+id/btnZoomOut" style="@style/Btn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="−" />
                <Button android:id="@+id/btnZoomIn" style="@style/Btn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+" />
            </LinearLayout>
        </HorizontalScrollView>

        <hu.videovago.TimelineView
            android:id="@+id/timeline"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="8dp" />
    </LinearLayout>

    <!-- panel -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/bg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="24dp">

            <CheckBox
                android:id="@+id/chkSnap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:checked="true"
                android:text="Kezdet igazítása kulcskockára"
                android:textColor="@color/text" />

            <TextView
                android:id="@+id/txtKeys"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/muted"
                android:textSize="12sp" />

            <TextView style="@style/Header" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Megtartott szakaszok" />

            <LinearLayout
                android:id="@+id/segList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button android:id="@+id/btnClear" style="@style/Btn" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Összes törlése" />
                <Button android:id="@+id/btnInvert" style="@style/Btn" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Megfordítás" />
            </LinearLayout>

            <TextView style="@style/Header" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Forgatás (metaadat)" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button android:id="@+id/btnRotL" style="@style/Btn" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="↺ 90°" />
                <Button android:id="@+id/btnRotR" style="@style/Btn" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="↻ 90°" />
                <Button android:id="@+id/btnRot180" style="@style/Btn" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="180°" />
                <Button android:id="@+id/btnRot0" style="@style/Btn" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Alap" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="A forgatás a fájl megjelenítési adatai közé kerül, a képpontok változatlanok. A telefonok, a VLC, a böngészők és a vágóprogramok mind figyelembe veszik."
                android:textColor="@color/muted"
                android:textSize="12sp" />

            <TextView style="@style/Header" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Exportálás" />

            <RadioGroup
                android:id="@+id/modeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/radioMerge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Egy fájlba fűzve"
                    android:textColor="@color/text" />

                <RadioButton
                    android:id="@+id/radioSeparate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Külön fájlokba"
                    android:textColor="@color/text" />
            </RadioGroup>

            <CheckBox
                android:id="@+id/chkAudio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Hang megtartása"
                android:textColor="@color/text" />

            <Button
                android:id="@+id/btnExport"
                style="@style/Btn.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:minHeight="52dp"
                android:text="⬇ Exportálás újrakódolás nélkül" />

            <ProgressBar
                android:id="@+id/progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:max="1000"
                android:progressTint="@color/accent" />

            <TextView
                android:id="@+id/txtStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button android:id="@+id/btnCancel" style="@style/Btn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Megszakítás" android:visibility="gone" />
                <Button android:id="@+id/btnPlayOut" style="@style/Btn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="▶ Lejátszás" android:visibility="gone" />
                <Button android:id="@+id/btnShare" style="@style/Btn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Megosztás" android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="A kész videó a Filmek/Videovago mappába kerül (MP4). Veszteségmentes vágásnál a kezdet csak kulcskockára eshet, ezért az app a kezdőpontot a megelőző kulcskockára igazítja (az idővonalon a szürke jelek). A vég bármelyik képkocka lehet."
                android:textColor="@color/muted"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
