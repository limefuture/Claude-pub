<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">@color/teal</item>
        <item name="android:colorPrimary">@color/teal_dark</item>
        <item name="android:colorPrimaryDark">@color/teal_dark</item>
        <item name="android:colorControlActivated">@color/teal</item>
        <item name="android:statusBarColor">@color/teal_dark</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:alertDialogTheme">@style/DialogTheme</item>
    </style>

    <style name="EditorTheme" parent="AppTheme">
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="DialogTheme" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">@color/teal</item>
        <item name="android:windowBackground">@drawable/bg_dialog</item>
    </style>

    <style name="IconBtn">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="android:tint">@color/text</item>
    </style>

    <style name="IconBtn.Teal">
        <item name="android:tint">@color/teal</item>
    </style>

    <style name="BraceBtn">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
    </style>

    <style name="TimeText">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>
</resources>
